# 前端开发环境配置（vite dev 模式自动加载，非密钥，可提交）
#
# 流式 SSE 请求直连后端，绕过 Vite dev server 代理。
# 根因：Vite 6 代理把 chunked SSE 响应缓冲到后端关闭连接才一次性返回，
# 前端 fetch 等不到响应头 → net::ERR_ABORTED。
# 后端 app/main.py 已配置 CORS 允许 http://localhost:5173。
#
# 生产环境不加载此文件（vite build 为 production 模式），
# STREAMING_BASE 退化为相对 /api，走 nginx 同源代理（已配 X-Accel-Buffering: no）。
VITE_API_BASE_URL=http://localhost:8001
